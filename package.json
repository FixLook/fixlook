    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
